# Contact form CAPTCHA signing key. Generate a long random value, for example:
# openssl rand -base64 48
CONTACT_CAPTCHA_SECRET="kronel-studio-contact-captcha"

# SMTP server settings. Port 465 normally uses implicit TLS; port 587 normally
# uses STARTTLS. Set SMTP_SECURE explicitly if your provider requires otherwise.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kronel Studio <no-reply@kronel.io>"

# Contact form destination.
CONTACT_EMAIL_TO=gabi.balasz@gmail.com
